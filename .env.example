# App and server config
SPRING_APPLICATION_NAME=gatewayservice
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:6080,http://localhost:8080,http://react-service
HOSTS=main=localhost,jenkins=jenkins.localhost*

# Redis rate-limit config
REDIS_HOST=gateway-redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me
REDIS_CONNECT_TIMEOUT=10s
REDIS_TIMEOUT=10s

# Allow 10 login attempts per 15 minutes per client IP
LOGIN_RATE_LIMIT_MAX_REQUESTS=10
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15

# Allow 2 registrations per hour per client IP
REGISTER_RATE_LIMIT_MAX_REQUESTS=2
REGISTER_RATE_LIMIT_WINDOW_MINUTES=60

# Allow 3 password-reset requests per hour per client IP
PASSWORD_RESET_RATE_LIMIT_MAX_REQUESTS=3
PASSWORD_RESET_RATE_LIMIT_WINDOW_MINUTES=60

# HTTPS certificate settings
SERVER_SSL_ENABLED=true
SERVER_SSL_KEY_STORE=file:/gatewayservice/certs/keystore.p12
SERVER_SSL_KEY_STORE_PASSWORD=change-me
SERVER_SSL_KEY_STORE_TYPE=PKCS12
